  "eval_sources": [
    {
      "id": "lmms-lab/MMMU",
      "name": "mmmu_holdout",
      "modality": "image",
      "split": "validation",
      "eval_only": true,
      "max_records": 1000
    },
    {
      "id": "lighteval/mmlu",
      "name": "mmlu_holdout",
      "modality": "text",
      "split": "test",
      "eval_only": true,
      "max_records": 2000
    }
  ],
  "avoid_as_primary_targets": [
    "third-party SFT assistant answers",
    "empty-prompt or prompt-free self-continuation",
    "audio rows without a verified teacher endpoint, dataset config, and split",
    "evaluation holdouts",
    "unfiltered raw crawl dumps"
  ],
  "teacher_output_filters": {
    "min_estimated_tokens": 8,
    "drop_empty": true,
    "drop_near_duplicates": true,
    "drop_greeting_boilerplate": true,
    "drop_endpoint_failure_text": true
  }
}
