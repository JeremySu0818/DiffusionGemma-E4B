      "modality": "text",
      "split": "train",
      "enabled": true,
      "required": false,
      "max_records": 100000,
      "streaming": true,
      "teacher_prompt": "Analyze the supplied educational context and produce a rigorous, self-contained explanation with any necessary reasoning.",
      "license_hint": "follow dataset card terms"
    },
    {
      "id": "lmms-lab/LLaVA-ReCap-558K",
