{
  "schema_version": 2,
  "objective": "Distill Gemma 4 E4B behavior into an E4B-sized multimodal Diffusion Transformer.",
  "principle": "Third-party rows provide prompts, context, and images only. Training targets are generated by the configured Gemma teacher.",
  "mix_unit": "prompt records; realized training-block shares are recorded in corruption_manifest.json and validation_report.json",
  "student_capabilities": ["text", "image", "audio"],
  "unsupported_capabilities": [],
  "formal_target_policy": {
    "teacher_generated_outputs": true,
    "prompt_free_self_continuation": false,
    "third_party_assistant_answers_as_primary_targets": false,
    "raw_corpus_denoising_warmup": false
  },
  "recommended_mix": [
    {
      "bucket": "teacher_supervised_text_general",
      "share": 0.69,
      "required": true,
      "target": "Broad chat, instruction following, knowledge, and long-context behavior"
    },
    {
      "bucket": "teacher_supervised_text_reasoning_code",
      "share": 0.3,
      "required": true,
      "target": "Reasoning, mathematics, science, and code behavior"
    },
    {
      "bucket": "teacher_supervised_image",
      "share": 0.01,
      "required": true,
      "target": "General image understanding, documents, OCR, charts, and diagrams"
    }
  ],
  "sources": [
    {
      "id": "HuggingFaceH4/ultrachat_200k",
      "name": "ultrachat_prompts",
      "bucket": "teacher_supervised_text_general",
      "role": "prompt_context_bank",
      "modality": "text",
      "split": "train_sft",
      "enabled": true,
      "required": false,
      "max_records": 150000,
      "streaming": true,
      "license_hint": "use prompts only; follow dataset card terms"
    },
    {
      "id": "allenai/WildChat-nontoxic",
      "name": "wildchat_nontoxic_prompts",
      "bucket": "teacher_supervised_text_general",
      "role": "prompt_context_bank",
      "modality": "text",
      "split": "train",
      "enabled": true,
      "required": false,
      "max_records": 100000,
      "streaming": true,
      "license_hint": "use user prompts only; follow dataset card terms"
    },
    {
      "id": "data-is-better-together/10k_prompts_ranked",
      "name": "ranked_prompt_bank",
      "bucket": "teacher_supervised_text_general",
      "role": "prompt_context_bank",
      "modality": "text",
      "split": "train",
      "enabled": true,
      "required": false,
      "max_records": 15000,
      "streaming": true,
      "license_hint": "follow dataset card terms"
    },
    {
      "id": "allenai/tulu-3-sft-mixture",
